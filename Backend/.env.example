[TEMPLATE]
# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Render managed Postgres — set to the Render-provided URL in production)
DATABASE_URL=
postgresql://postgres:root@localhost:5432/wellbepro?schema=public

# JWT Configuration (required in production — use a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Dev only: allow x-tenant-id without JWT (never enable in production)
# ALLOW_TENANT_HEADER=true

# Public API / asset base (optional). When unset in development,
# /uploads/... paths stay relative so frontends can proxy via Next rewrite.
# Production: set to the deployed Render backend URL, e.g. BACKEND_URL=https://reza-backend.onrender.com
# BACKEND_URL=http://localhost:5000

# CORS — comma-separated list of allowed frontend origins.
# Production: add the real Vercel URLs after first deploy, e.g.
# FRONTEND_URL=https://reza-pro.vercel.app,https://reza-client.vercel.app
FRONTEND_URL=http://localhost:3000
# PRO_APP_URL=https://pro.reza.ma
# CLIENT_APP_URL=https://www.reza.ma
# CLIENT_URL=https://www.reza.ma

# Cloudinary (required in production — image uploads are stored here, never on
# Render's ephemeral local disk). Two equivalent ways to configure it:
#
# OPTION A (recommended) — the exact value Cloudinary's dashboard shows under
# Dashboard → Account Details → "CLOUDINARY_URL":
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# OPTION B — individual values (CLOUDINARY_CLOUD_NAME must be the cloud name
# ALONE, e.g. dqceikk6h — NOT the full cloudinary:// URL):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery — used for ALL platform emails: password reset, email
# confirmation, RDV notifications. Three paths (first key found wins):
#
# OPTION A — Brevo (best without an owned domain): HTTPS on port 443, which
# cloud hosts never block. Verify your OWN email as sender — no DNS needed.
# 300 emails/day free. brevo.com → SMTP & API → API Keys / Senders.
# BREVO_API_KEY=xxxxxxxxxxxx
# BREVO_SENDER_EMAIL=your-email@gmail.com   (must be verified in Brevo → Senders)
# BREVO_SENDER_NAME=Reza
#
# OPTION B — SMTP (fallback; the mailer probes 587/465 + IPv4/hostname):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user@example.com   (also the From address)
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=Reza

# Multi-Tenant Configuration
DEFAULT_TENANT_ID=default

# Superadmin: created by the demo seed (no HTTP bootstrap endpoint)
#   npm run seed   → superadmin@gmail.com / 123456
