# Backend API URL — points at the deployed Render backend in production.
# Local dev: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Platform bank details (shown on the "Moyen de paiement plateforme" page).
# REQUIRED before production deploy, or salons will see placeholder details.
NEXT_PUBLIC_PLATFORM_BANK_NAME=Banque Populaire
NEXT_PUBLIC_PLATFORM_BANK_HOLDER=Reza Platform
NEXT_PUBLIC_PLATFORM_BANK_IBAN=MA000000000000000000000000
NEXT_PUBLIC_PLATFORM_BANK_SWIFT=
